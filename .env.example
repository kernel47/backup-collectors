LOG_LEVEL=INFO

# General Referencial URL.
BACKUP_REFERENCIAL_URL=
# Asset lookup URL: supports {hostname}, otherwise hostname is appended to the path.
BACKUP_REFERENCIAL_ASSET_URL=
BACKUP_REFERENCIAL_TOKEN=
BACKUP_REFERENCIAL_TIMEOUT=15

OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_CA_CERT=
OPENSEARCH_TIMEOUT=30
# Global maximum; set to 1 to write each document immediately.
OPENSEARCH_BATCH_SIZE=500
# Policies and SLP: lower per-collection limit (also capped by the global maximum).
OPENSEARCH_CONFIGURATION_BATCH_SIZE=50
OPENSEARCH_MAX_BATCH_MB=10
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_SCRIPT_JOBS=backup_jobs_upsert
OPENSEARCH_SCRIPT_IMAGES=backup_images_upsert
OPENSEARCH_SCRIPT_CONFIGURATIONS=backup_configuration_upsert
HISTORY_MAX_VERSIONS=10

NETBACKUP_VERIFY_SSL=true
NETBACKUP_CA_CERT=
NETBACKUP_TIMEOUT=60
# SSL_CERT_FILE can also configure the CA used by httpx (including Referencial).
